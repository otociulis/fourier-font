{
  "name": "fourier-font",
  "version": "1.0.0",
  "description": "A TypeScript Fourier handwriting laboratory",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "generate:font": "tsx scripts/generate-font.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/space-grotesk": "^5.2.0",
    "@mantine/core": "^8.3.0",
    "@mantine/hooks": "^8.3.0",
    "fft.js": "^4.0.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/opentype.js": "^1.3.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "opentype.js": "1.3.4",
    "postcss": "^8.5.0",
    "postcss-preset-mantine": "^1.18.0",
    "svg-path-properties": "^2.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.12"
  },
  "author": "Oto Ciulis <oto.ciulis@gmail.com>",
  "license": "ISC"
}